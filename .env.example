# Copy to .development.env for npm run start:dev.
# Copy to .production.env for production and fill in your own values.

# PostgreSQL
POSTGRES_LOGIN=postgres
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_AUTHDATABASE=reviews

# Authentication: use a long, randomly generated secret.
JWT_SECRET=replace-with-random-secret

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-local-password

# Redis (currently disabled in app.module.ts)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# DaData
DADATA_API_KEY=
DADATA_SECRET_KEY=
